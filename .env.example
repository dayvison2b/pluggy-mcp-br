# Pluggy client id
PLUGGY_CLIENT_ID=

# Pluggy client secret
PLUGGY_CLIENT_SECRET=

# Optional. Base64 alternative to PLUGGY_CLIENT_SECRET
PLUGGY_CLIENT_SECRET_B64=

# Comma-separated item ids from Meu Pluggy
PLUGGY_ITEM_IDS=

# Public origin, no path
PUBLIC_URL=

# Owner password, at least 16 characters
OWNER_PASSWORD=

# HMAC key for OAuth tokens, at least 32 characters
OAUTH_SIGNING_SECRET=
